# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin configuration (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay (server-only except the public key)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL used by ML-Service to call the Next.js analysis callback.
# For ngrok testing, use the current HTTPS ngrok URL without a trailing slash.
APP_BASE_URL=http://localhost:3000

# ML-Service
ML_SERVICE_URL=http://localhost:7860
ML_SERVICE_SECRET=

# LLM and ingestion providers
GEMINI_API_KEY=
GEMINI_INGESTION_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Qdrant vector store
QDRANT_URL=
QDRANT_API_KEY=

# PubMed / NCBI
NCBI_API_KEY=

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=

# Kaggle
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Nanonets OCR
NANONETS_API_KEY=
